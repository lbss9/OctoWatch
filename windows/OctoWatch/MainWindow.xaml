<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OctoWatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OctoWatch"
    xmlns:ctrl="using:OctoWatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OctoWatch">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título própria: título à esquerda, botões à direita (sem maximizar) -->
        <Grid Grid.Row="0" Height="44" Padding="14,0,6,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="OctoWatch" VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="2">
                <Button Click="OnMinimize" Width="40" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Minimizar para a bandeja">
                    <FontIcon Glyph="&#xE921;" FontSize="12" />
                </Button>
                <Button Click="OnClose" Width="40" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Fechar para a bandeja">
                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Conteúdo: aba única "GitHub Actions" -->
        <TabView Grid.Row="1" IsAddTabButtonVisible="False" CanReorderTabs="False"
                 VerticalAlignment="Stretch" Background="Transparent">
            <TabViewItem Header="GitHub Actions" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE9F5;" />
                </TabViewItem.IconSource>

                <Grid Padding="14" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra de entrada compacta -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OwnerBox" Grid.Column="0" PlaceholderText="owner" />
                        <TextBox x:Name="RepoBox" Grid.Column="1" PlaceholderText="repo" />
                        <PasswordBox x:Name="TokenBox" Grid.Column="2" PlaceholderText="token (opcional)" />
                        <Button x:Name="RefreshButton" Grid.Column="3" Click="OnRefresh"
                                Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Atualizar">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- Lista de cards (workflow runs = GitHub Actions) -->
                    <ScrollViewer Grid.Row="1">
                        <ListView x:Name="RunsList" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="OnCardClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RunCard">
                                    <Border CornerRadius="10" Padding="12,10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ctrl:StatusDot Grid.Column="0" State="{x:Bind State}"
                                                            VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.7"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- Rodapé de status -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="Spinner" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="StatusText" Opacity="0.8"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Text="Informe owner/repo e atualize." />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
