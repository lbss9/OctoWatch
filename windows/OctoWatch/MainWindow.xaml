<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="OctoWatch.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="OctoWatch"
>
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image
        Grid.Column="0"
        Width="18"
        Height="18"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Source="ms-appx:///Assets/OctoWatch.ico"
      />
      <TextBlock
        Grid.Column="1"
        Text="OctoWatch"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Style="{ThemeResource BodyStrongTextBlockStyle}"
      />
    </Grid>

    <NavigationView
      x:Name="NavView"
      Grid.Row="1"
      PaneDisplayMode="LeftCompact"
      IsSettingsVisible="True"
      IsBackButtonVisible="Collapsed"
      IsTitleBarAutoPaddingEnabled="False"
      OpenPaneLength="200"
      CompactPaneLength="48"
      Background="Transparent"
      SelectionChanged="OnNavSelectionChanged"
      PaneOpening="OnPaneOpening"
      PaneClosed="OnPaneClosed"
    >
      <!-- Keep the pane and content area transparent so the glass actually shows
           through (otherwise NavigationView's own background covers the acrylic). -->
      <NavigationView.Resources>
        <!-- Transparent content area (lets the app's glass show through). -->
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <!-- Pane background: an in-app acrylic that starts TRANSPARENT (collapsed rail =
             glass, homogeneous with the app). When the menu opens, the code-behind raises
             its opacity -> dark frosted glass that blurs the content behind (readable, no bleed). -->
        <AcrylicBrush
          x:Key="NavigationViewDefaultPaneBackground"
          TintColor="{ThemeResource SolidBackgroundFillColorBase}"
          TintOpacity="0"
          TintLuminosityOpacity="0"
          FallbackColor="Transparent"
        />
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeNav" x:Uid="Nav_Home" Tag="home">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE80F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="AboutNav" x:Uid="Nav_About" Tag="about">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE946;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="ChangelogNav" x:Uid="Nav_Changelog" Tag="changelog">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8A5;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
