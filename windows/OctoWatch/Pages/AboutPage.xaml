<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="OctoWatch.Pages.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ScrollViewer Padding="12,8,12,16">
    <StackPanel Spacing="12" MaxWidth="420">
      <FontIcon
        Glyph="&#xE945;"
        FontSize="32"
        HorizontalAlignment="Left"
        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
      />
      <TextBlock Text="OctoWatch" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock x:Name="VersionText" Opacity="0.8" Style="{ThemeResource BodyTextBlockStyle}" />
      <TextBlock
        x:Uid="About_Description"
        TextWrapping="Wrap"
        Style="{ThemeResource BodyTextBlockStyle}"
      />
      <TextBlock x:Uid="About_License" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" />
      <HyperlinkButton
        x:Uid="About_GitHubLink"
        NavigateUri="https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps#device-flow"
      />
    </StackPanel>
  </ScrollViewer>
</Page>
