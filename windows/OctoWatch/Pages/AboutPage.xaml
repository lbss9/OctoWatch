<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="OctoWatch.Pages.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ScrollViewer Padding="12,8,12,16">
    <StackPanel Spacing="12" MaxWidth="420">
      <Image
        Width="32"
        Height="32"
        HorizontalAlignment="Left"
        Source="ms-appx:///Assets/OctoWatch.ico"
      />
      <TextBlock Text="OctoWatch" Style="{ThemeResource TitleTextBlockStyle}" />
      <TextBlock x:Name="VersionText" Opacity="0.8" Style="{ThemeResource BodyTextBlockStyle}" />
      <TextBlock
        x:Uid="About_Description"
        TextWrapping="Wrap"
        Style="{ThemeResource BodyTextBlockStyle}"
      />
      <TextBlock x:Uid="About_License" Opacity="0.8" Style="{ThemeResource CaptionTextBlockStyle}" />
      <HyperlinkButton
        x:Uid="About_GitHubLink"
        Click="OnGitHubLink"
      />
    </StackPanel>
  </ScrollViewer>
</Page>
