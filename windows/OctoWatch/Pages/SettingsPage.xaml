<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="OctoWatch.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <ScrollViewer Padding="12,4,12,16">
    <StackPanel>
      <TextBlock x:Uid="Settings_AccountHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="10">
          <TextBlock
            x:Name="AccountStatusText"
            x:Uid="Settings_NotSignedIn"
            TextWrapping="Wrap"
            Style="{ThemeResource BodyTextBlockStyle}"
          />
          <InfoBar x:Name="AuthBar" IsOpen="False" IsClosable="True" />
          <StackPanel x:Name="SignedOutPanel" Spacing="8">
            <Button
              x:Name="SignInButton"
              x:Uid="Settings_SignIn"
              Click="OnSignIn"
              Style="{ThemeResource AccentButtonStyle}"
            />
            <StackPanel x:Name="DevicePanel" Spacing="8" Visibility="Collapsed">
              <TextBlock x:Uid="Settings_UserCodeHint" Opacity="0.75" Style="{ThemeResource CaptionTextBlockStyle}" />
              <TextBlock
                x:Name="UserCodeText"
                Style="{ThemeResource TitleTextBlockStyle}"
                IsTextSelectionEnabled="True"
              />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Settings_CopyCode" Click="OnCopyCode" />
                <Button x:Uid="Settings_OpenGithub" Click="OnOpenGithub" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="AuthSpinner" Width="16" Height="16" IsActive="False" />
                <TextBlock x:Name="AuthWaitText" x:Uid="Settings_WaitingAuth" Style="{ThemeResource CaptionTextBlockStyle}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button x:Name="SignOutButton" x:Uid="Settings_SignOut" Click="OnSignOut" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_ReposHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock
            x:Uid="Settings_ReposDescription"
            TextWrapping="Wrap"
            Opacity="0.75"
            Style="{ThemeResource CaptionTextBlockStyle}"
          />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="RepoSearchBox"
              x:Uid="Settings_RepoSearch"
              Grid.Column="0"
              TextChanged="OnRepoSearch"
            />
            <Button x:Name="LoadReposButton" x:Uid="Settings_LoadRepos" Grid.Column="1" Click="OnLoadRepos" />
          </Grid>
          <ListView
            x:Name="RepoList"
            MaxHeight="220"
            SelectionMode="None"
          >
            <ListView.ItemTemplate>
              <DataTemplate>
                <CheckBox
                  Content="{Binding FullName}"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_EventsHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock
            x:Uid="Settings_EventsDescription"
            TextWrapping="Wrap"
            Opacity="0.75"
            Style="{ThemeResource CaptionTextBlockStyle}"
          />
          <ComboBox
            x:Name="EventScopeBox"
            HorizontalAlignment="Stretch"
            SelectionChanged="OnEventScopeChanged"
          />
          <StackPanel x:Name="EventsPanel" Spacing="2" />
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_PollingHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <ComboBox
          x:Name="PollingBox"
          HorizontalAlignment="Stretch"
          SelectionChanged="OnPollingChanged"
        />
      </Border>

      <TextBlock x:Uid="Settings_LanguageHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <ComboBox
          x:Name="LanguageBox"
          HorizontalAlignment="Stretch"
          SelectionChanged="OnLanguageChanged"
        />
      </Border>

      <TextBlock x:Uid="Settings_ThemeHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <ComboBox
          x:Name="ThemeBox"
          HorizontalAlignment="Stretch"
          SelectionChanged="OnThemeChanged"
        />
      </Border>

      <TextBlock x:Uid="Settings_TransparencyHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock x:Uid="Settings_AcrylicLabel" Style="{ThemeResource BodyTextBlockStyle}" />
              <TextBlock
                x:Uid="Settings_AcrylicDesc"
                TextWrapping="Wrap"
                Opacity="0.7"
                Style="{ThemeResource CaptionTextBlockStyle}"
              />
            </StackPanel>
            <ToggleSwitch
              x:Name="AcrylicSwitch"
              Grid.Column="1"
              HorizontalAlignment="Right"
              MinWidth="0"
              OnContent=""
              OffContent=""
              Toggled="OnAcrylicToggled"
            />
          </Grid>

          <StackPanel x:Name="OpacityPanel" Spacing="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Uid="Settings_OpacityLabel" Style="{ThemeResource BodyTextBlockStyle}" />
              <TextBlock
                x:Name="OpacityValue"
                Grid.Column="1"
                Opacity="0.8"
                Style="{ThemeResource BodyTextBlockStyle}"
              />
            </Grid>
            <Slider
              x:Name="OpacitySlider"
              Minimum="0"
              Maximum="100"
              StepFrequency="5"
              TickFrequency="10"
              ValueChanged="OnOpacityChanged"
            />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              x:Uid="Settings_Apply"
              Click="OnApplyTransparency"
              Style="{ThemeResource AccentButtonStyle}"
            />
            <Button x:Uid="Settings_ResetDefault" Click="OnResetTransparency" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_StartupHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="Settings_StartupDescription"
            Grid.Column="0"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            Style="{ThemeResource BodyTextBlockStyle}"
          />
          <ToggleSwitch
            x:Name="StartupSwitch"
            Grid.Column="1"
            HorizontalAlignment="Right"
            MinWidth="0"
            OnContent=""
            OffContent=""
            Toggled="OnStartupToggled"
          />
        </Grid>
      </Border>

      <TextBlock x:Uid="Settings_UpdatesHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="Settings_AutoUpdate"
              Grid.Column="0"
              TextWrapping="Wrap"
              VerticalAlignment="Center"
              Style="{ThemeResource BodyTextBlockStyle}"
            />
            <ToggleSwitch
              x:Name="AutoUpdateSwitch"
              Grid.Column="1"
              HorizontalAlignment="Right"
              MinWidth="0"
              OnContent=""
              OffContent=""
              Toggled="OnAutoUpdateToggled"
            />
          </Grid>
          <Button
            x:Name="CheckUpdatesButton"
            x:Uid="Settings_CheckUpdates"
            Click="OnCheckUpdates"
          />
          <TextBlock
            x:Name="UpdateStatusText"
            TextWrapping="Wrap"
            Opacity="0.75"
            Style="{ThemeResource CaptionTextBlockStyle}"
          />
        </StackPanel>
      </Border>

      <TextBlock x:Uid="Settings_QuitHeader" Style="{StaticResource SectionHeaderStyle}" />
      <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock
            x:Uid="Settings_QuitDescription"
            TextWrapping="Wrap"
            Opacity="0.75"
            Style="{ThemeResource CaptionTextBlockStyle}"
          />
          <Button x:Uid="Settings_Quit" Click="OnQuit" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
