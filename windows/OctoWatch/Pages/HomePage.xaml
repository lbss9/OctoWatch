<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="OctoWatch.Pages.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:OctoWatch"
  xmlns:ctrl="using:OctoWatch.Controls"
>
  <Grid Padding="8,4,8,8" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="ManualRepoBar" Grid.Row="0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="OwnerBox" x:Uid="Home_Owner" Grid.Column="0" PlaceholderText="owner" />
      <TextBox x:Name="RepoBox" x:Uid="Home_Repo" Grid.Column="1" PlaceholderText="repo" />
    </Grid>

    <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

    <!-- Feed. No right padding so cards sit next to the overlay scrollbar. -->
    <ListView
      x:Name="FeedList"
      Grid.Row="2"
      Padding="0"
      SelectionMode="None"
      IsItemClickEnabled="True"
      ItemClick="OnCardClick"
    >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,2,6" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:FeedItem">
          <Border
            CornerRadius="8"
            Padding="12,9"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          >
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ctrl:StatusDot
                Grid.Column="0"
                State="{x:Bind State}"
                VerticalAlignment="Center"
              />
              <StackPanel Grid.Column="1" Spacing="1">
                <Grid ColumnSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    Grid.Column="0"
                    Glyph="{x:Bind KindGlyph}"
                    FontSize="12"
                    Opacity="0.55"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                  />
                </Grid>
                <TextBlock
                  Text="{x:Bind Subtitle}"
                  Opacity="0.65"
                  TextTrimming="CharacterEllipsis"
                  Style="{ThemeResource CaptionTextBlockStyle}"
                />
              </StackPanel>
              <Button
                Grid.Column="2"
                Tag="{x:Bind}"
                Click="OnCardMenuClick"
                Padding="6,4"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0.6"
              >
                <FontIcon Glyph="&#xE712;" FontSize="16" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Footer: status on the left; filter, refresh, and clear on the right. -->
    <Grid Grid.Row="3" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressRing x:Name="Spinner" IsActive="False" Width="16" Height="16" />
        <TextBlock
          x:Name="StatusText"
          Opacity="0.8"
          VerticalAlignment="Center"
          Style="{ThemeResource CaptionTextBlockStyle}"
        />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button
          x:Name="FilterButton"
          Padding="8,6"
          Background="Transparent"
          BorderThickness="0"
        >
          <FontIcon Glyph="&#xE71C;" FontSize="14" />
          <Button.Flyout>
            <Flyout Placement="Top">
              <StackPanel Spacing="4" MinWidth="160">
                <CheckBox
                  x:Name="FilterActionsCheck"
                  IsChecked="True"
                  Checked="OnFilterToggle"
                  Unchecked="OnFilterToggle"
                />
                <CheckBox
                  x:Name="FilterPullsCheck"
                  IsChecked="True"
                  Checked="OnFilterToggle"
                  Unchecked="OnFilterToggle"
                />
                <CheckBox
                  x:Name="FilterBranchesCheck"
                  IsChecked="True"
                  Checked="OnFilterToggle"
                  Unchecked="OnFilterToggle"
                />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button
          x:Name="RefreshButton"
          Click="OnRefresh"
          Padding="8,6"
          Background="Transparent"
          BorderThickness="0"
        >
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
        <HyperlinkButton x:Name="ClearButton" Click="OnClear" Padding="8,4" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
